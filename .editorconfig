# EditorConfig: https://editorconfig.org
# Applies to new edits only; this file does not reformat existing sources.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown hard line break.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
