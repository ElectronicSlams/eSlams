{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@eslams/core-contracts": ["../core-contracts/src/generated/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
