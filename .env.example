# Copy to .env for local use. Leave these empty in git. Do not commit .env or real secrets.

# HMAC secret for arena session_state. Set this in production; unset uses a development constant.
ESLAMS_ARENA_SESSION_SECRET=
# Non-secret key id for that HMAC. Unset becomes "configured" when the secret is set.
ESLAMS_ARENA_SESSION_KEY_ID=
# Set to 1 to allow the debug observation view. Any other value stays public_compact.
ESLAMS_ENABLE_DEBUG_OBSERVATION=

# Provider keys. Google and Gemini both read GEMINI_API_KEY. Set only the providers you call.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=

# Ed25519 runner artifact signing key (base64: or hex:, 32 bytes). Never written into the artifact.
RUNNER_ARTIFACT_SIGNING_PRIVATE_KEY=
# Non-secret signing key id. Unset records runner-artifact-env-key.
RUNNER_ARTIFACT_SIGNING_KEY_ID=
# Ed25519 public key for eslams validate. Unset can derive it from the private key above.
RUNNER_ARTIFACT_VERIFY_PUBLIC_KEY=
# Legacy HMAC key for old artifacts. Official bundle validation still rejects legacy HMAC.
RUNNER_SIGNING_KEY=
