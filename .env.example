# Reference only: Core does not automatically load .env files.
# Copy to an ignored .env, fill only the settings needed, then explicitly export
# them in your shell or configure the service environment. Never commit values.

# Session HMAC: a configured random secret of at least 32 characters is required.
ESLAMS_ARENA_SESSION_SECRET=
# Optional nonsecret ID; omitted defaults to configured. Do not export an empty ID.
ESLAMS_ARENA_SESSION_KEY_ID=
# Optional positive age in seconds; omitted defaults to 86400.
ESLAMS_ARENA_SESSION_MAX_AGE_SECONDS=
# Local-only opt-in to a development constant; leave disabled in shared services.
ESLAMS_ARENA_SESSION_ALLOW_DEVELOPMENT_SECRET=
ESLAMS_ENV=

# Authenticated runner HTTP: secret and explicit key ID are required together.
ESLAMS_RUNNER_REQUEST_SECRET=
ESLAMS_RUNNER_REQUEST_KEY_ID=
# Rotation requires both previous values; remove them after callers switch.
ESLAMS_RUNNER_REQUEST_SECRET_PREVIOUS=
ESLAMS_RUNNER_REQUEST_KEY_ID_PREVIOUS=
# Optional positive request age; omitted defaults to 300 seconds.
ESLAMS_RUNNER_REQUEST_MAX_AGE_SECONDS=
# Local-only unsigned HTTP opt-in; leave disabled in shared services.
ESLAMS_RUNNER_REQUEST_ALLOW_UNSIGNED=

# Debug observation requires exactly 1 and a request selecting debug view.
# It includes private state and must never be browser streamed or shared publicly.
ESLAMS_ENABLE_DEBUG_OBSERVATION=
# CLI exception tracebacks: 1/true/yes/on. Tracebacks may contain private details.
ESLAMS_DEBUG=

# Configure only providers you deliberately call. No live call is needed for tests.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=

# Ed25519: base64: or hex: followed by exactly 32 raw key bytes.
RUNNER_ARTIFACT_SIGNING_PRIVATE_KEY=
# Optional nonsecret ID; omitted defaults to runner-artifact-env-key.
RUNNER_ARTIFACT_SIGNING_KEY_ID=
# Auditor verification public key, not a signing key. Also exactly 32 raw bytes.
RUNNER_ARTIFACT_VERIFY_PUBLIC_KEY=
# Compatibility reader for legacy HMAC artifacts; never Official evidence.
RUNNER_SIGNING_KEY=
