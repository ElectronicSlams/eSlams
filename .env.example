# Reference only: Core does not automatically load .env files.
# Copy to an ignored .env, fill only the settings needed, then explicitly export
# them in your shell or configure the service environment. Never commit values.

# Direct Baichuan API (optional; requires an exact provider-native model ID).
BAICHUAN_API_KEY=

# Session HMAC: a configured random secret of at least 32 characters is required.
ESLAMS_ARENA_SESSION_SECRET=
# Optional nonsecret ID; omitted defaults to configured. Do not export an empty ID.
ESLAMS_ARENA_SESSION_KEY_ID=
# Optional positive age in seconds; omitted defaults to 86400.
ESLAMS_ARENA_SESSION_MAX_AGE_SECONDS=
# Local-only opt-in to a development constant; leave disabled in shared services.
ESLAMS_ARENA_SESSION_ALLOW_DEVELOPMENT_SECRET=
ESLAMS_ENV=

# Authenticated runner HTTP: secret and explicit key ID are required together.
ESLAMS_RUNNER_REQUEST_SECRET=
ESLAMS_RUNNER_REQUEST_KEY_ID=
# Rotation requires both previous values; remove them after callers switch.
ESLAMS_RUNNER_REQUEST_SECRET_PREVIOUS=
ESLAMS_RUNNER_REQUEST_KEY_ID_PREVIOUS=
# Optional positive request age; omitted defaults to 300 seconds.
ESLAMS_RUNNER_REQUEST_MAX_AGE_SECONDS=
# Optional host-local SQLite replay protection file shared by runner workers.
# Empty selects the bounded atomic in-process backend; not a multi-host ledger.
ESLAMS_RUNNER_NONCE_DB=
# Local-only unsigned HTTP opt-in; leave disabled in shared services.
ESLAMS_RUNNER_REQUEST_ALLOW_UNSIGNED=

# Debug observation requires exactly 1 and a request selecting debug view.
# It includes private state and must never be browser streamed or shared publicly.
ESLAMS_ENABLE_DEBUG_OBSERVATION=
# CLI exception tracebacks: 1/true/yes/on. Tracebacks may contain private details.
ESLAMS_DEBUG=

# Configure only providers you deliberately call. No live call is needed for tests.
CLOVASTUDIO_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Direct Ant Ling (Ant Group / Bailing).
ANT_LING_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LIQUID_API_KEY=
AI21_API_KEY=
RELACE_API_KEY=
PERCEPTRON_API_KEY=
MORPH_API_KEY=
MOONSHOT_API_KEY=
UPSTAGE_API_KEY=
STEPFUN_API_KEY=
ARCEE_API_KEY=
INCEPTION_API_KEY=
REKA_API_KEY=
LONGCAT_API_KEY=
QIANFAN_API_KEY=
# NVIDIA API Catalog hosted endpoint: development/test entitlement only.
NVIDIA_API_KEY=
APODEX_API_KEY=
MISTRAL_API_KEY=
SARVAM_API_KEY=
WRITER_API_KEY=
MINIMAX_API_KEY=
FIREWORKS_API_KEY=
POOLSIDE_API_KEY=
MIMO_API_KEY=
PERPLEXITY_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
DASHSCOPE_API_KEY=
# Optional Core settings: omit to use Singapore's legacy host. Do not export empty values.
DASHSCOPE_REGION=
DASHSCOPE_WORKSPACE_ID=
# IBM Cloud direct chat: API key is exchanged for an IAM bearer, never sent to inference.
WATSONX_API_KEY=
# Required region; see docs/PROVIDER_WATSONX.md. Exactly one project or space is required.
WATSONX_REGION=
WATSONX_PROJECT_ID=
WATSONX_SPACE_ID=
# Optional compatible API date; omit to use the pinned adapter version.
WATSONX_API_VERSION=
BYTEPLUS_API_KEY=
SENSENOVA_API_KEY=
ATRIA_API_KEY=
# Red Hat AI Inference on IBM Cloud, separate from watsonx and Granite author names.
IBM_RHAI_API_KEY=
# Explicit documented region (us-east) and project. See docs/PROVIDER_IBM_RHAI.md.
IBM_RHAI_REGION=
IBM_RHAI_PROJECT_ID=
# Databricks native chat: workspace HTTPS origin and caller-provided bearer token.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# Snowflake requires an explicit HTTPS account origin and native model ID.
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_TOKEN=
# Optional: OAUTH, KEYPAIR_JWT, PROGRAMMATIC_ACCESS_TOKEN; unset detects token type.
SNOWFLAKE_TOKEN_TYPE=
# Spark HTTP APIPassword for the selected model, not a WebSocket API key.
IFLYTEK_API_PASSWORD=
KRUTRIM_CLOUD_API_KEY=
STREAMLAKE_API_KEY=
# KAT direct text API: omit for international; explicitly set cn for China.
# A blank exported value is invalid. This does not select a billing plan or a model.
ESLAMS_STREAMLAKE_REGION=
CONTEXTUAL_API_KEY=

# Ed25519: base64: or hex: followed by exactly 32 raw key bytes.
RUNNER_ARTIFACT_SIGNING_PRIVATE_KEY=
# Optional nonsecret ID; omitted defaults to runner-artifact-env-key.
RUNNER_ARTIFACT_SIGNING_KEY_ID=
# Auditor verification public key, not a signing key. Also exactly 32 raw bytes.
RUNNER_ARTIFACT_VERIFY_PUBLIC_KEY=
# Compatibility reader for legacy HMAC artifacts; never Official evidence.
RUNNER_SIGNING_KEY=

# Native DeepSeek Chat Completions (https://api.deepseek.com)
DEEPSEEK_API_KEY=
# Sakana Namazu direct API (optional; never export every blank placeholder).
SAKANA_API_KEY=
# Huawei MaaS direct inference (Guiyang); optional, no default model.
HUAWEI_MAAS_API_KEY=

# Azure Foundry direct v1 inference: explicit deployment required (see docs/AZURE_FOUNDRY.md).
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
# Optional: api-key (default) or entra; export only the settings you use.
AZURE_AI_AUTH_MODE=
AZURE_AI_AUTH_TOKEN=
# Tencent native Hunyuan (not TokenHub/Coding Plan); optional STS token and region.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_TOKEN=
TENCENTCLOUD_REGION=
# Native Cohere Platform Chat v2 (optional)
COHERE_API_KEY=

# Standard direct API keys; never substitute a Coding Plan key.
ZAI_API_KEY=
ZHIPU_API_KEY=
