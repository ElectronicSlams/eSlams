{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eslams.com/schemas/model-execution-policy.v1.json",
  "title": "eSlams model execution policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "thinking",
    "output"
  ],
  "properties": {
    "schema_version": {
      "const": "eslams.model-execution-policy.v1"
    },
    "thinking": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "unbounded"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "duration_ms"
          ],
          "properties": {
            "mode": {
              "const": "bounded"
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "output": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "provider_default"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "max_tokens"
          ],
          "properties": {
            "mode": {
              "const": "bounded"
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
